  "services": {
    "set_active_power_limit": {
      "description": "Caps the inverter's active power as a percentage of its rated power. The cap ignores the house's consumption and holds until the active power failsafe timeout runs out.",
      "fields": {
        "config_entry_id": {
          "description": "The E3/DC power station to send this to.",
          "name": "Power station"
        },
        "limit": {
          "description": "The output ceiling, as a percentage of rated power.",
          "name": "Limit"
        }
      },
      "name": "Set active power limit"
    },
    "set_battery_power": {
      "description": "Charges or discharges the battery at a fixed power. PV power charges first and the grid makes up the rest. The power station returns to normal control unless this is sent again within 30 seconds.",
      "fields": {
        "config_entry_id": {
          "description": "The E3/DC power station to send this to.",
          "name": "Power station"
        },
        "power": {
          "description": "Positive values charge the battery, negative values discharge it.",
          "name": "Power"
        }
      },
      "name": "Set battery power"
    },
    "set_feed_in_limit": {
      "description": "Caps the power fed into the grid. The power station returns to its own limit unless this is sent again within 30 seconds.",
      "fields": {
        "config_entry_id": {
          "description": "The E3/DC power station to send this to.",
          "name": "Power station"
        },
        "power": {
          "description": "The most power to feed into the grid.",
          "name": "Power"
        }
      },
      "name": "Set feed-in limit"
    },
    "stop_battery_control": {
      "description": "Ends remote battery control at once, without waiting for its 30-second timeout.",
      "fields": {
        "config_entry_id": {
          "description": "The E3/DC power station to send this to.",
          "name": "Power station"
        }
      },
      "name": "Stop battery control"
    }
  }
